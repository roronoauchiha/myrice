{
    "layer": "top",
    "position": "top",

    "height": 30,
    "spacing": 6,

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
        "cava",
	"clock"
    ],


"modules-right": [
    "group/sysinfo",
    "group/network",
    "pulseaudio",
    "idle_inhibitor",
    "battery",
    "custom/notifications",
    "custom/power"
],

    // ─────────────────────────
    // WORKSPACES + OPEN APPS
    // ─────────────────────────

    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,

        "format": "{name} {windows}",
        "format-window-separator": " ",

        "window-rewrite-default": "",

        "window-rewrite": {
            "class<kitty>": "",
            "class<foot>": "",
            "class<Alacritty>": "",

            "class<firefox>": "",
            "class<google-chrome>": "",
            "class<chromium>": "",

            "class<org.telegram.desktop>": "",
            "class<discord>": "",

            "class<code>": "󰨞",
            "class<codium>": "󰨞",

            "class<dolphin>": "",
            "class<org.kde.dolphin>": "",

            "class<mpv>": "󰐹",
            "class<vlc>": "󰕼"
        }
    },

    // ─────────────────────────
    // CAVA
    // ─────────────────────────

    "cava": {
        "framerate": 30,
        "autosens": 1,
        "bars": 8,
        "lower_cutoff_freq": 50,
        "higher_cutoff_freq": 10000,

        "method": "pulse",
        "source": "auto",

        "stereo": true,

        "bar_delimiter": 0,

        "format-icons": [
            "▁",
            "▂",
            "▃",
            "▄",
            "▅",
            "▆",
            "▇",
            "█"
        ]
    },

       "clock": {
        "interval": 1,
        "format": "{:%I:%M %p}",
        "rotate": 0,
        "format-alt": "{:%R %d·%m·%y}",
        "tooltip-format": "<span>{calendar}</span>",

        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "on-click-right": "mode",

            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b>{}</b></span>"
            }
        },

        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },


    // ─────────────────────────
    // SYSTEM INFO
    // ─────────────────────────

    "group/sysinfo": {
        "orientation": "horizontal",

        "drawer": {
            "transition-duration": 300,
            "click-to-reveal": true,
            "transition-left-to-right": false
        },

        "modules": [
            "custom/cpu-icon",
            "cpu",
            "custom/memory-icon",
            "memory",
            "custom/disk-icon",
            "disk"
        ]
    },

    "custom/cpu-icon": {
        "format": "",
        "tooltip": false
    },

    "cpu": {
        "interval": 10,
        "format": "{usage}%"
    },

    "custom/memory-icon": {
        "format": "󰾅",
        "tooltip": false
    },

    "memory": {
        "interval": 2,
        "format": "{used}GB",
        "max-length": 10,
        "tooltip": true,
        "tooltip-format": " {used:0.1f}GB/{total:0.1f}GB"
    },

    "custom/disk-icon": {
        "format": "",
        "tooltip": false
    },

    "disk": {
        "interval": 30,
        "format": "{free}",
        "path": "/",
        "tooltip": true,
        "tooltip-format": "Storage - {used} used out of {total} on {path} ({percentage_used}%)"
    },


    // ─────────────────────────
    // NETWORK
    // ─────────────────────────

    "group/network": {
        "orientation": "horizontal",

        "drawer": {
            "transition-duration": 300,
            "click-to-reveal": true,
            "transition-left-to-right": false
        },

        "modules": [
            "network",
            "network#speed"
        ]
    },

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 {ifname}",
        "format-disconnected": "󰤭",
        "tooltip-format": "{ifname}: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}"
    },

    "network#speed": {
        "interval": 1,
        "format": "󰇚 {bandwidthDownBytes} 󰕒 {bandwidthUpBytes}",
        "tooltip": false
    },


    // ─────────────────────────
    // CAFFEINE
    // ─────────────────────────

    "idle_inhibitor": {
        "format": "{icon}",

        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰾪"
        },

        "tooltip-format-activated": "Caffeine: ON",
        "tooltip-format-deactivated": "Caffeine: OFF"
    },


    // ─────────────────────────
    // BATTERY
    // ─────────────────────────

    "battery": {
        "interval": 5,

        "states": {
            "warning": 30,
            "critical": 15
        },

        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",

        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    },


    // ─────────────────────────
    // NOTIFICATIONS
    // ─────────────────────────

    "custom/notifications": {
        "format": "󰂚",
        "tooltip": true,

        "on-click": "swaync-client -t",
        "on-click-right": "swaync-client -d",

        "exec": "swaync-client -swb",
        "exec-if": "command -v swaync-client",

        "return-type": "json",
        "interval": 1
    },


    // ─────────────────────────
    // POWER / ROFI
    // ─────────────────────────

    "custom/power": {
        "format": "󰐥",
        "tooltip": "Power menu",

        "on-click": "bash -c 'choice=$(printf \"󰐥 Shutdown\\n󰜉 Reboot\\n󰍃 Logout\\n󰒲 Suspend\" | rofi -dmenu -i -p \"Power\"); case \"$choice\" in *Shutdown) systemctl poweroff ;; *Reboot) systemctl reboot ;; *Logout) hyprctl dispatch exit ;; *Suspend) systemctl suspend ;; esac'"
    }
}

// ─────────────────────────
// AUDIO
// ─────────────────────────

"pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 Muted",
    "tooltip": false,

    "format-icons": {
        "default": [
            "󰕿",
            "󰖀",
            "󰕾"
        ]
    },

    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
},

"pulseaudio#microphone": {
    "format": "󰍬 {format_source}",
    "format-source": "{volume}%",
    "format-source-muted": "󰍭 Muted",
    "tooltip": false,

    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
}

