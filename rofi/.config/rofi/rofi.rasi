* {
    bg:        #0b0d12;
    bg-alt:    #12151c;
    bg-hover:  #191d27;

    fg:        #e6eaf2;
    fg-muted:  #9299aa;

    accent:    #a8b8ff;
    border:    #252b38;
}


window {
    background-color: @bg;
    border: 2px;
    border-color: @border;
    border-radius: 14px;
}

mainbox {
    background-color: transparent;
    padding: 12px;
}

inputbar {
    background-color: @bg-alt;
    border: 1px;
    border-color: @border;
    border-radius: 10px;
    padding: 10px;
}

entry {
    text-color: @fg;
}

prompt {
    text-color: @accent;
}

listview {
    background-color: transparent;
    spacing: 6px;
    padding: 8px 0px;
}

element {
    background-color: transparent;
    text-color: @fg;
    border-radius: 9px;
    padding: 10px;
}

element selected {
    background-color: @bg-hover;
    text-color: @fg;
    border: 1px;
    border-color: @accent;
}

element-text {
    text-color: inherit;
}

element-icon {
    size: 28px;
}
