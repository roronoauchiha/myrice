[global]
    monitor = 0
    follow = mouse

    width = 380
    height = (110, 110)
    origin = top-right
    offset = (20, 20)

    scale = 0

    notification_limit = 5

    progress_bar = true
    progress_bar_height = 5
    progress_bar_frame_width = 0
    progress_bar_min_width = 160
    progress_bar_max_width = 350

    indicate_hidden = yes

    transparency = 8
    separator_height = 2
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12

    frame_width = 1
    frame_color = "#19b89b"

    corner_radius = 18
    corners = all

    font = JetBrainsMono Nerd Font 10

    markup = full
    format = "<b>%s</b>\n%b"

    alignment = left
    vertical_alignment = center

    show_age_threshold = 60
    ellipsize = middle

    icon_position = left
    min_icon_size = 42
    max_icon_size = 52

    sticky_history = yes
    history_length = 20

    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all


[urgency_low]
    background = "#17151f"
    foreground = "#b8b4c8"
    frame_color = "#6f5aa8"
    timeout = 4


[urgency_normal]
    background = "#171a1b"
    foreground = "#f2f4f3"
    frame_color = "#19b89b"
    timeout = 5


[urgency_critical]
    background = "#21161b"
    foreground = "#fff1f3"
    frame_color = "#ff5c7a"
    timeout = 8
